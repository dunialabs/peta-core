# Database connection
DATABASE_URL="postgresql://peta:peta123@localhost:5433/peta_mcp_gateway?schema=public"

# JWT secret (please change to a secure random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Development environment configuration
NODE_ENV="development"

# Logging configuration (Pino Logger)
LOG_LEVEL="info"            # Log level: trace|debug|info|warn|error|fatal (dev default: trace, prod default: info)
LOG_PRETTY="false"           # Whether to use pretty output (dev default: true, prod default: false)
LOG_RESPONSE_MAX_LENGTH=300  # Maximum characters for response result, will be truncated if exceeded (0=unlimited, dev recommendation: 2000, prod recommendation: 300)

# Backend server configuration
BACKEND_PORT=3002
BACKEND_HTTPS_PORT=3002      # HTTPS port, defaults to same as HTTP port

# Peta Auth auto-start (default: true)
PETA_AUTH_AUTOSTART='true'

# MCP Server Lazy Loading (default: true)
# When enabled, servers load config into memory but delay startup until first use
# Idle servers automatically shut down to conserve resources
LAZY_START_ENABLED='true'

# Modern MCP 2026-07-28 rollout (default: disabled)
# When disabled, modern-looking requests are rejected fail-closed before legacy routing.
MCP_2026_ENABLED='false'
MCP_2026_SUPPORTED_VERSIONS='2026-07-28'
# Optional canary allowlists; leave empty to allow all modern OAuth clients/tenants.
# MCP_2026_ALLOWED_CLIENT_IDS=''
# MCP_2026_ALLOWED_TENANT_IDS=''

# URL-based OAuth Client ID metadata fetch compatibility (default: true)
# Allows hostname DNS results in 198.18.0.0/15 for Clash/Surge/Shadowrocket fake-IP mode.
# Direct IP metadata URLs and real private/localhost/link-local targets remain rejected.
OAUTH_CLIENT_METADATA_ALLOW_FAKE_IP='true'

# HTTPS/SSL configuration
ENABLE_HTTPS=false           # Enable HTTPS (when true, both services enable HTTPS, when false, both use HTTP)
SSL_CERT_PATH=/Users/peta/cert/localhost+2.pem  # SSL certificate path
SSL_KEY_PATH=/Users/peta/cert/localhost+2-key.pem    # SSL private key path


PETA_CLOUD_API_URL='https://peta-cloud.xxx.workers.dev'

# Result cache configuration
# Controls caching for tools/call, resources/read, prompts/get.
# Cache is disabled by default. When disabled, backend-specific settings are ignored.
RESULT_CACHE_ENABLED='false'         # Default: false
RESULT_CACHE_BACKEND='db'            # Default: db. Options: db | redis | memory | noop
RESULT_CACHE_STRICT_STARTUP='false'  # Default: false. When true, fail startup if cache backend init/healthcheck fails

# Global cache defaults applied when an entity-level cache policy omits a field.
RESULT_CACHE_DEFAULT_TTL_SECONDS=30              # Default: 30. Range: 1-86400
RESULT_CACHE_DEFAULT_ADMISSION_POLICY='immediate'  # Default: immediate. Options: immediate | second_hit
RESULT_CACHE_DEFAULT_ADMISSION_WINDOW_SECONDS=300  # Default: 300. Range: 1-86400
RESULT_CACHE_MAX_ENTRY_BYTES=262144             # Default: 262144 (256 KiB). Range: 1024-5242880

# Cache key namespace prefix.
# Default behavior: if unset, uses "peta:${NODE_ENV}" (for example: peta:development).
# RESULT_CACHE_KEY_PREFIX='peta:development'

# Compression settings for cached payload envelopes.
RESULT_CACHE_COMPRESS='auto'         # Default: auto. Options: true | false | auto
RESULT_CACHE_COMPRESSION_MIN_BYTES=4096  # Default: 4096. Compress only when payload >= this size

# DB backend housekeeping.
# Only used when RESULT_CACHE_BACKEND='db'.
RESULT_CACHE_DB_SWEEP_INTERVAL_SECONDS=300  # Default: 300
RESULT_CACHE_DB_SWEEP_BATCH_SIZE=1000       # Default: 1000

# Memory backend capacity.
# Only used when RESULT_CACHE_BACKEND='memory'.
RESULT_CACHE_MEMORY_MAX_ENTRIES=1000  # Default: 1000

# Redis backend connection.
# Required when RESULT_CACHE_BACKEND='redis'.
# REDIS_URL='redis://localhost:6379'
